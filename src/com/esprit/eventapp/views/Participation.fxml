<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.ParticipationController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <VBox HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="tesk-hero-title" text="Gestion des Participations" />
                  <Label styleClass="tesk-caption" text="Consultez et gérez les inscriptions aux événements." />
               </children>
            </VBox>
         </children>
      </HBox>
      
      <HBox fx:id="statsContainer" alignment="CENTER" spacing="20.0" style="-fx-padding: 0 0 20 0;">
         <children>
            <VBox alignment="CENTER" prefWidth="150.0" styleClass="login-card" style="-fx-background-color: #2c3e50;">
               <children>
                  <Label text="Total" style="-fx-text-fill: white; -fx-font-size: 14px;" />
                  <Label fx:id="lblTotalStats" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
               </children>
               <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            </VBox>
            <VBox alignment="CENTER" prefWidth="150.0" styleClass="login-card" style="-fx-background-color: #27ae60;">
               <children>
                  <Label text="Confirmés" style="-fx-text-fill: white; -fx-font-size: 14px;" />
                  <Label fx:id="lblConfirmedStats" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
               </children>
               <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            </VBox>
            <VBox alignment="CENTER" prefWidth="150.0" styleClass="login-card" style="-fx-background-color: #f39c12;">
               <children>
                  <Label text="Waitlist" style="-fx-text-fill: white; -fx-font-size: 14px;" />
                  <Label fx:id="lblWaitlistStats" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
               </children>
               <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            </VBox>
            <VBox alignment="CENTER" prefWidth="150.0" styleClass="login-card" style="-fx-background-color: #3498db;">
               <children>
                  <Label text="Présents" style="-fx-text-fill: white; -fx-font-size: 14px;" />
                  <Label fx:id="lblPresentStats" text="0" style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" />
               </children>
               <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0" /></padding>
            </VBox>
         </children>
      </HBox>

      <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="login-card" style="-fx-padding: 15;">
         <children>
            <TextField fx:id="searchField" promptText="Rechercher un utilisateur ou événement..." styleClass="text-field" HBox.hgrow="ALWAYS" />
            <ComboBox fx:id="statusFilter" prefWidth="150.0" promptText="Statut" styleClass="text-field" />
            <Button mnemonicParsing="false" onAction="#refreshTable" styleClass="button-secondary" text="🔄 Actualiser" />
            <Button mnemonicParsing="false" onAction="#handleExport" style="-fx-background-color: #27ae60; -fx-text-fill: white;" styleClass="button-secondary" text="📥 Exporter CSV" />
         </children>
      </HBox>
      
      <VBox styleClass="login-card" VBox.vgrow="ALWAYS">
         <children>
            <TableView fx:id="participationTable" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colUser" prefWidth="200.0" text="Utilisateur" />
                <TableColumn fx:id="colEvent" prefWidth="200.0" text="Événement" />
                <TableColumn fx:id="colDate" prefWidth="150.0" text="Date Inscription" />
                <TableColumn fx:id="colStatus" prefWidth="120.0" text="Statut" />
                <TableColumn fx:id="colActions" prefWidth="180.0" text="Actions" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
</VBox>
