<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.EventDetailsController">
    <children>
        <Label fx:id="lblTitre" styleClass="title" style="-fx-font-size: 48; -fx-padding: 0 0 0 20; -fx-letter-spacing: 0; -fx-effect: none;" text="Détails Événement" />

        <VBox spacing="10.0" styleClass="login-card" style="-fx-padding: 20;">
            <children>
                <Label fx:id="lblType" styleClass="subtitle" text="Type:" />
                <Label fx:id="lblDate" text="Date:" />
                <Label fx:id="lblHeure" text="Heure:" />
                <Label fx:id="lblLieu" text="Lieu:" />
                <Separator />
                <Label text="Description" style="-fx-font-weight: bold;" />
                <Label fx:id="lblDescription" wrapText="true" text="" />
            </children>
        </VBox>

        <HBox spacing="30.0" VBox.vgrow="ALWAYS">
            <children>
                <VBox prefWidth="420.0" spacing="15.0" styleClass="login-card" style="-fx-padding: 25;">
                    <children>
                        <Label styleClass="subtitle" text="Laisser un avis" />
                        <TextField fx:id="txtNom" promptText="Votre nom" styleClass="text-field" />
                        <ComboBox fx:id="comboNote" maxWidth="1.7976931348623157E308" promptText="Note (sur 5)" styleClass="text-field" />
                        <TextArea fx:id="txtCommentaire" prefHeight="120.0" promptText="Votre commentaire..." styleClass="text-field" />
                        <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#submitAvis" styleClass="button" text="Publier l'avis" />
                    </children>
                </VBox>

                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="subtitle" text="Avis des autres" />
                        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="avisContainer" spacing="12.0">
                                    <padding>
                                        <Insets right="5.0" />
                                    </padding>
                                </VBox>
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="40.0" />
    </padding>
</VBox>

