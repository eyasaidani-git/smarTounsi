<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<ScrollPane fitToWidth="true" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.EventDetailsController" style="-fx-background-color: #f4f6f8; -fx-padding: 0;">
    <content>
        <VBox spacing="0">
            <!-- Hero Banner -->
            <StackPane prefHeight="350.0" style="-fx-background-color: #2a2a2a;">
                <ImageView fx:id="heroImage" fitHeight="350.0" preserveRatio="false" StackPane.alignment="CENTER" opacity="0.6"/>
                <VBox alignment="CENTER" spacing="10.0">
                    <Label fx:id="lblTitreHero" text="Titre de l'événement" style="-fx-font-family: 'Montserrat', sans-serif; -fx-font-size: 56px; -fx-font-weight: 700; -fx-text-fill: white; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.8), 10, 0, 0, 0);"/>
                    <HBox alignment="CENTER" spacing="10.0">
                        <Label fx:id="lblLieuHero" text="📍 Lieu de l'événement" style="-fx-font-family: 'Montserrat', sans-serif; -fx-font-size: 20px; -fx-text-fill: white;"/>
                    </HBox>
                </VBox>
                <VBox alignment="TOP_RIGHT" StackPane.alignment="TOP_RIGHT" style="-fx-padding: 30;">
                    <VBox style="-fx-background-color: rgba(255,255,255,0.9); -fx-background-radius: 8; -fx-padding: 15 25; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 10, 0, 0, 4);">
                        <Label text="A partir de" style="-fx-font-size: 14px; -fx-text-fill: #666;"/>
                        <HBox alignment="BOTTOM_LEFT" spacing="5">
                             <Label fx:id="lblPrixHero" text="50" style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                             <Label text="TND" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e74c3c; -fx-padding: 0 0 5 0;"/>
                        </HBox>
                    </VBox>
                </VBox>
                
                <Button mnemonicParsing="false" onAction="#goBack" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" text="⬅ Retour" StackPane.alignment="TOP_LEFT">
                    <StackPane.margin>
                        <Insets top="20.0" left="20.0"/>
                    </StackPane.margin>
                </Button>
            </StackPane>

            <!-- Main Content -->
            <HBox spacing="30.0" style="-fx-padding: 40 50;">
                
                <!-- Left Sidebar: Billets -->
                <VBox prefWidth="380.0" spacing="20.0">
                    <VBox styleClass="login-card" style="-fx-padding: 25; -fx-background-radius: 12;">
                        <Label text="- BILLETS -" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-alignment: center; -fx-text-fill: #333;" maxWidth="Infinity" alignment="CENTER"/>
                        <Separator style="-fx-padding: 10 0;"/>
                        
                        <HBox spacing="10.0">
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="📅 Début:" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                                <Label fx:id="lblDateDebutBillet" text="13/05/2026 20:30" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                            </VBox>
                            <Separator orientation="VERTICAL"/>
                            <VBox HBox.hgrow="ALWAYS">
                                <Label text="🏁 Fin:" style="-fx-text-fill: #7f8c8d; -fx-font-size: 14px;"/>
                                <Label fx:id="lblDateFinBillet" text="13/05/2026 23:30" style="-fx-font-weight: bold; -fx-font-size: 15px;"/>
                            </VBox>
                        </HBox>
                        
                        <Separator style="-fx-padding: 15 0;"/>
                        
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <Label text="Billet Standard" style="-fx-font-size: 16px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <HBox alignment="BOTTOM_LEFT" spacing="2">
                                <Label fx:id="lblPrixBillet" text="50" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                                <Label text="TND" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 0 0 2 0;"/>
                            </HBox>
                        </HBox>
                        
                        <Region prefHeight="15.0"/>
                        
                        <StackPane>
                            <Button fx:id="btnReserver" text="🎟 RÉSERVER" styleClass="button-primary" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 20;" maxWidth="Infinity" onAction="#handleReserver"/>
                            <Label fx:id="lblSoldOut" managed="false" text="Sold Out" style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-padding: 12 20; -fx-background-radius: 8; -fx-alignment: center;" maxWidth="Infinity" visible="false"/>
                        </StackPane>
                        
                        <Label fx:id="lblPlacesStatus" text="100 places disponibles" style="-fx-text-fill: #27ae60; -fx-font-size: 13px; -fx-padding: 10 0 0 0;" maxWidth="Infinity" alignment="CENTER"/>
                        
                        <VBox fx:id="userStatusBox" managed="false" visible="false" spacing="5.0" style="-fx-padding: 15 0 0 0;">
                            <Separator/>
                            <Label text="Votre Statut :" style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                            <Label fx:id="lblUserStatusInfo" text="En attente" style="-fx-font-size: 14px; -fx-text-fill: #f39c12;"/>
                        </VBox>
                    </VBox>
                    
                    <!-- Admin Actions -->
                    <VBox fx:id="actionsBox" spacing="10.0" visible="false" managed="false" styleClass="login-card" style="-fx-padding: 20; -fx-background-radius: 12;">
                        <Label text="Administration" style="-fx-font-weight: bold; -fx-font-size: 16px; -fx-text-fill: #e74c3c;"/>
                        <Button text="✏️ Modifier l'événement" maxWidth="Infinity" onAction="#handleEdit" styleClass="button-secondary"/>
                        <Button text="🗑 Supprimer l'événement" maxWidth="Infinity" onAction="#handleDelete" style="-fx-background-color: transparent; -fx-border-color: #e74c3c; -fx-text-fill: #e74c3c; -fx-border-radius: 8; -fx-cursor: hand;"/>
                    </VBox>
                </VBox>

                <!-- Right Content: Description & Avis -->
                <VBox spacing="30.0" HBox.hgrow="ALWAYS" maxWidth="800.0">
                    <!-- Feature Badges -->
                    <HBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label text="Type" style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;"/>
                            <Label fx:id="lblTypeDesc" text="Spectacle" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label text="Début" style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;"/>
                            <Label fx:id="lblDateDebutDesc" text="13/05/2026 20:30" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        </VBox>
                        <Separator orientation="VERTICAL"/>
                        <VBox alignment="CENTER" HBox.hgrow="ALWAYS">
                            <Label text="Fin" style="-fx-text-fill: #95a5a6; -fx-font-size: 13px;"/>
                            <Label fx:id="lblDateFinDesc" text="13/05/2026 23:30" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                        </VBox>
                    </HBox>
                    
                    <VBox alignment="CENTER" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                        <ImageView fx:id="contentImage" fitWidth="780.0" preserveRatio="true"/>
                    </VBox>
                    
                    <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 4);">
                        <Label text="Description" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Label fx:id="lblDescription" wrapText="true" text="Description of the event..." style="-fx-font-size: 16px; -fx-line-spacing: 1.5; -fx-text-fill: #444;"/>
                    </VBox>
                    
                    <!-- Avis Section -->
                    <HBox spacing="30.0">
                        <VBox prefWidth="400.0" spacing="15.0" styleClass="login-card" style="-fx-padding: 25; -fx-background-radius: 12;">
                            <Label text="Laisser un avis" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <TextField fx:id="txtNom" promptText="Votre nom" styleClass="text-field" />
                            <ComboBox fx:id="comboNote" maxWidth="Infinity" promptText="Note (sur 5)" styleClass="text-field" />
                            <TextArea fx:id="txtCommentaire" prefHeight="100.0" promptText="Votre commentaire..." styleClass="text-field" />
                            <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#submitAvis" styleClass="button-primary" text="Publier l'avis" />
                        </VBox>
                        
                        <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                            <Label text="Avis des autres" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                            <VBox fx:id="avisContainer" spacing="15.0"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
