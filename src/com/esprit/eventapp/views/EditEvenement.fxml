<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.EditEvenementController">
   <content>
      <VBox spacing="20.0">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#goBack" styleClass="button-link" text="⬅ Retour" />
                  <Label style="-fx-font-size: 48; -fx-padding: 0; -fx-letter-spacing: 0; -fx-effect: none;" styleClass="title" text="Modifier l'événement" />
               </children>
            </HBox>

            <VBox maxWidth="800.0" spacing="25.0" styleClass="login-card">
               <children>
                  <VBox spacing="15.0">
                     <children>
                        <VBox spacing="5.0">
                           <children>
                              <Label text="Titre de l'événement" textFill="#2d3436" />
                              <TextField fx:id="titreField" promptText="Ex: Tournoi de robotique" />
                           </children>
                        </VBox>

                        <VBox spacing="5.0">
                           <children>
                              <Label text="Description" textFill="#2d3436" />
                              <TextArea fx:id="descField" prefHeight="80.0" promptText="Description de l'événement..." wrapText="true" />
                           </children>
                        </VBox>

                        <HBox spacing="20.0">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Type" textFill="#2d3436" />
                                    <TextField fx:id="typeField" promptText="Ex: Compétition, Formation..." />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Lieu" textFill="#2d3436" />
                                    <TextField fx:id="lieuField" promptText="Ex: Salle C3" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>

                        <VBox spacing="15.0">
                           <children>
                              <Label style="-fx-font-weight: bold;" text="📅 Début (Date &amp; Heure)" textFill="#2d3436" />
                              <HBox spacing="15.0">
                                 <children>
                                    <DatePicker fx:id="dateDebutPicker" maxWidth="Infinity" promptText="jj/mm/aaaa" styleClass="text-field" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="heureDebutField" prefWidth="120.0" promptText="hh:mm" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <VBox spacing="15.0">
                           <children>
                              <Label style="-fx-font-weight: bold;" text="🏁 Fin (Date &amp; Heure)" textFill="#2d3436" />
                              <HBox spacing="15.0">
                                 <children>
                                    <DatePicker fx:id="dateFinPicker" maxWidth="Infinity" promptText="jj/mm/aaaa" styleClass="text-field" HBox.hgrow="ALWAYS" />
                                    <TextField fx:id="heureFinField" prefWidth="120.0" promptText="hh:mm" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>

                        <HBox spacing="20.0">
                           <children>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Prix (TND)" textFill="#2d3436" />
                                    <TextField fx:id="prixField" promptText="Ex: 50.0" />
                                 </children>
                              </VBox>
                              <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label text="Places Disponibles" textFill="#2d3436" />
                                    <TextField fx:id="placesField" promptText="Ex: 100" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>

                  <HBox alignment="CENTER_RIGHT" spacing="15.0">
                     <children>
                        <Label fx:id="messageLabel" textFill="#d63031" />
                        <Button mnemonicParsing="false" onAction="#handleSave" styleClass="button-primary" text="💾 Sauvegarder les modifications" />
                     </children>
                  </HBox>
               </children>
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
               </padding>
            </VBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="40.0" />
         </padding>
      </VBox>
   </content>
</ScrollPane>
