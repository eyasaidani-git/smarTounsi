<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.AvisController">
   <children>
      <Label styleClass="title" style="-fx-font-size: 48; -fx-padding: 0 0 0 20; -fx-letter-spacing: 0; -fx-effect: none;" text="Avis sur les Événements" />
      
      <HBox spacing="30.0" VBox.vgrow="ALWAYS">
         <children>
            <!-- Formulaire d'ajout d'avis -->
            <VBox prefWidth="400.0" spacing="15.0" styleClass="login-card" style="-fx-padding: 30; -fx-max-width: 400;">
               <children>
                  <Label styleClass="subtitle" text="Laisser un avis" />
                  <ComboBox fx:id="comboEvenement" maxWidth="1.7976931348623157E308" promptText="Sélectionner un événement" styleClass="text-field" />
                  <TextField fx:id="txtNom" promptText="Votre nom" styleClass="text-field" />
                  <ComboBox fx:id="comboNote" maxWidth="1.7976931348623157E308" promptText="Note (sur 5)" styleClass="text-field" />
                  <TextArea fx:id="txtCommentaire" prefHeight="100.0" promptText="Votre commentaire..." styleClass="text-field" />
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#submitAvis" styleClass="button" text="Publier l'avis" />
               </children>
            </VBox>

            <!-- Tableau des événements -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="subtitle" text="Tous les événements" />
                  <TableView fx:id="tableEvenements" VBox.vgrow="ALWAYS">
                    <columns>
                      <TableColumn fx:id="colId" prefWidth="90.0" text="ID" />
                      <TableColumn fx:id="colTitre" prefWidth="220.0" text="Titre" />
                      <TableColumn fx:id="colType" prefWidth="160.0" text="Type" />
                      <TableColumn fx:id="colDate" prefWidth="140.0" text="Date" />
                      <TableColumn fx:id="colLieu" prefWidth="200.0" text="Lieu" />
                    </columns>
                  </TableView>
               </children>
            </VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="40.0" />
   </padding>
</VBox>
