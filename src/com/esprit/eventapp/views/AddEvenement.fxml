<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.AddEvenementController">
   <children>
      <HBox alignment="CENTER_LEFT" spacing="15.0">
         <children>
            <Button mnemonicParsing="false" onAction="#goBack" styleClass="button-link" text="⬅ Retour" />
            <Label styleClass="title" style="-fx-font-size: 48; -fx-padding: 0; -fx-letter-spacing: 0; -fx-effect: none;" text="Créer un nouvel événement" />
         </children>
      </HBox>

      <VBox maxWidth="800.0" spacing="25.0" styleClass="login-card">
         <children>
            <VBox spacing="15.0">
               <children>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Titre de l'événement" textFill="#2d3436" />
                        <TextField fx:id="titreField" promptText="Ex: Tournoi de robotique" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Description" textFill="#2d3436" />
                        <TextArea fx:id="descField" prefRowCount="3" promptText="Détails de l'événement..." styleClass="text-field" />
                     </children>
                  </VBox>

                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Type" textFill="#2d3436" />
                              <TextField fx:id="typeField" promptText="Ex: Compétition, Formation..." />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Lieu" textFill="#2d3436" />
                              <TextField fx:id="lieuField" promptText="Ex: Salle C3" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>

                  <HBox spacing="20.0">
                     <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Date" textFill="#2d3436" />
                              <DatePicker fx:id="dateField" maxWidth="1.7976931348623157E308" styleClass="text-field" />
                           </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                           <children>
                              <Label text="Heure (HH:MM)" textFill="#2d3436" />
                              <TextField fx:id="heureField" promptText="Ex: 14:30" />
                           </children>
                        </VBox>
                     </children>
                  </HBox>
               </children>
            </VBox>
            
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Label fx:id="messageLabel" textFill="#d63031" />
                  <Button mnemonicParsing="false" onAction="#handleSave" styleClass="button-primary" text="Enregistrer l'événement" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
      </VBox>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="40.0" />
   </padding>
</VBox>
