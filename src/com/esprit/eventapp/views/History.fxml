<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.HistoryController">
   <children>
      <Label styleClass="title" style="-fx-font-size: 48; -fx-padding: 0 0 0 20; -fx-letter-spacing: 0; -fx-effect: none;" text="Historique des Événements" />
      <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
         <content>
            <VBox spacing="40.0">
               <children>
                  <VBox spacing="15.0">
                     <children>
                        <Label styleClass="subtitle" text="Événements Futurs" />
                        <FlowPane fx:id="futureEventsGrid" hgap="30.0" vgap="30.0" />
                     </children>
                  </VBox>
                  <VBox spacing="15.0">
                     <children>
                        <Label styleClass="subtitle" text="Événements Passés" />
                        <FlowPane fx:id="pastEventsGrid" hgap="30.0" vgap="30.0" />
                     </children>
                  </VBox>
               </children>
               <padding>
                  <Insets bottom="30.0" left="30.0" right="30.0" top="10.0" />
               </padding>
            </VBox>
         </content>
      </ScrollPane>
   </children>
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="40.0" />
   </padding>
</VBox>
