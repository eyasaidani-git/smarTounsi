<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>

<VBox alignment="TOP_CENTER" styleClass="main-container" stylesheets="@../assets/css/style.css" xmlns="http://javafx.com/javafx/8.0.171" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.esprit.eventapp.controllers.SignUpController">
   <children>
      <VBox alignment="CENTER" maxWidth="1.7976931348623157E308" styleClass="title-container">
         <children>
            <Label styleClass="title" text="SmarTounsi" maxWidth="1.7976931348623157E308" alignment="CENTER" />
            <Label styleClass="subtitle" text="Rejoignez la communauté de l'excellence" />
         </children>
      </VBox>
      
      <StackPane VBox.vgrow="ALWAYS">
         <children>
            <VBox alignment="CENTER" maxWidth="1000.0" spacing="45.0" styleClass="login-card">
               <children>
                  <VBox spacing="20.0">
                     <children>
                        <HBox spacing="20.0">
                           <children>
                              <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                                 <children>
                                    <Label text="Nom" textFill="#2d3436" />
                                    <TextField fx:id="nomField" promptText="Nom" />
                                 </children>
                              </VBox>
                              <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                                 <children>
                                    <Label text="Prénom" textFill="#2d3436" />
                                    <TextField fx:id="prenomField" promptText="Prénom" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                        <VBox spacing="10.0">
                           <children>
                              <Label text="Email" textFill="#2d3436" />
                              <TextField fx:id="emailField" promptText="nom@exemple.com" />
                           </children>
                        </VBox>
                        <VBox spacing="10.0">
                           <children>
                              <Label text="Mot de passe" textFill="#2d3436" />
                              <PasswordField fx:id="passwordField" promptText="••••••••" />
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  
                  <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleSignUp" styleClass="button-primary" text="S'inscrire" />
                  
                  <Label fx:id="messageLabel" styleClass="label-message" textFill="#d63031" />
                  
                  <VBox alignment="CENTER" spacing="15.0">
                     <children>
                        <Label text="Déjà membre ?" textFill="#636e72" />
                        <Button mnemonicParsing="false" onAction="#switchToSignIn" styleClass="button-link" text="Se connecter" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
</VBox>
