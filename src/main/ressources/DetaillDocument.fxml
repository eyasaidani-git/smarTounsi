<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #F0F8FC;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.DetailDocumentController">

    <!-- ═══════════════ SIDEBAR ═══════════════ -->
    <left>
        <VBox prefWidth="210" style="-fx-background-color: #023047;">

            <VBox alignment="CENTER" style="-fx-background-color: #FEB707; -fx-padding: 18 12 18 12;">
                <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #023047;" text="⊞ smarTounsi"/>
            </VBox>

            <VBox spacing="2" style="-fx-padding: 16 10 10 10;">

                <Label style="-fx-text-fill: #8ECBE6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 10 6 4 6;" text="PRINCIPALE"/>

                <Button fx:id="btnDashboard" maxWidth="Infinity" onAction="#handleDashboard"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="⌂  Dashboard"/>

                <Button fx:id="btnModules" maxWidth="Infinity" onAction="#handleModules"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="⊞  Modules"/>

                <Button fx:id="btnDocuments" maxWidth="Infinity" onAction="#handleDocuments"
                        style="-fx-background-color: #229DBC; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="▣  Documents"/>

                <Label style="-fx-text-fill: #8ECBE6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 14 6 4 6;" text="OUTILS"/>

                <Button fx:id="btnQuiz" maxWidth="Infinity" onAction="#handleQuiz"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="□  Quiz"/>

                <Button fx:id="btnPlanning" maxWidth="Infinity" onAction="#handlePlanning"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="▦  Planning"/>

                <Button fx:id="btnJira" maxWidth="Infinity" onAction="#handleJira"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="✦  Jira"/>

                <Button fx:id="btnUpload" maxWidth="Infinity" onAction="#handleUpload"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="↑  Upload"/>

                <Button fx:id="btnFavoris" maxWidth="Infinity" onAction="#handleFavoris"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="★  Favoris"/>

                <Label style="-fx-text-fill: #8ECBE6; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 14 6 4 6;" text="AUTRE"/>

                <Button fx:id="btnProfil" maxWidth="Infinity" onAction="#handleProfil"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="⊙  Profil"/>

                <Button fx:id="btnNotification" maxWidth="Infinity" onAction="#handleNotification"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 9 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="🔔  Notification"/>
            </VBox>

            <VBox VBox.vgrow="ALWAYS"/>

            <VBox style="-fx-padding: 10 10 16 10;">
                <Button fx:id="btnDeconnexion" maxWidth="Infinity" onAction="#handleDeconnexion"
                        style="-fx-background-color: #FB8402; -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold; -fx-alignment: CENTER-LEFT; -fx-padding: 10 12; -fx-cursor: hand; -fx-background-radius: 6;"
                        text="⏻  Déconnexion"/>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════ CONTENU ═══════════════ -->
    <center>
        <VBox spacing="0" style="-fx-background-color: #F0F8FC;">

            <!-- En-tête -->
            <VBox style="-fx-background-color: white; -fx-padding: 22 32 20 32;
                         -fx-effect: dropshadow(gaussian, rgba(2,48,71,0.10), 8, 0, 0, 3);">

                <!-- Breadcrumb -->
                <HBox alignment="CENTER_LEFT" spacing="6" style="-fx-padding: 0 0 8 0;">
                    <Button fx:id="btnRetourModules" onAction="#handleRetourModules"
                            style="-fx-background-color: transparent; -fx-text-fill: #8ECBE6;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 0; -fx-border-color: transparent;"
                            text="← Modules"/>
                    <Label style="-fx-text-fill: #8ECBE6; -fx-font-size: 11px;" text="›"/>
                    <Button fx:id="btnRetourModule" onAction="#handleRetourModule"
                            style="-fx-background-color: transparent; -fx-text-fill: #229DBC;
                                   -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 0; -fx-border-color: transparent;"
                            text="Mathématiques"/>
                    <Label style="-fx-text-fill: #8ECBE6; -fx-font-size: 11px;" text="›"/>
                    <Label fx:id="labelBreadcrumb"
                           style="-fx-text-fill: #023047; -fx-font-size: 11px; -fx-font-weight: bold;"
                           text="Algèbre linéaire et matrices"/>
                </HBox>

                <!-- Titre -->
                <Label fx:id="labelTitreDocument"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #FEB707;"
                       text="Algèbre linéaire et matrices"/>

                <Label fx:id="labelDescDocument"
                       style="-fx-font-size: 13px; -fx-text-fill: #229DBC; -fx-padding: 4 0 14 0;"
                       text="Opérations matricielles, déterminants et systèmes linéaires"/>

                <!-- Onglets -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Button fx:id="btnOngletCours" onAction="#handleOngletCours"
                            style="-fx-background-color: #229DBC; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;"
                            text="📖  Cours"/>
                    <Button fx:id="btnOngletTD" onAction="#handleOngletTD"
                            style="-fx-background-color: #F0F8FC; -fx-text-fill: #023047;
                                   -fx-font-size: 12px; -fx-border-color: #8ECBE6; -fx-border-width: 1.5;
                                   -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;"
                            text="📝  TD"/>
                    <Button fx:id="btnOngletDS" onAction="#handleOngletDS"
                            style="-fx-background-color: #F0F8FC; -fx-text-fill: #023047;
                                   -fx-font-size: 12px; -fx-border-color: #8ECBE6; -fx-border-width: 1.5;
                                   -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;"
                            text="📋  DS"/>
                    <Button fx:id="btnOngletExamen" onAction="#handleOngletExamen"
                            style="-fx-background-color: #F0F8FC; -fx-text-fill: #023047;
                                   -fx-font-size: 12px; -fx-border-color: #8ECBE6; -fx-border-width: 1.5;
                                   -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;"
                            text="📜  Examen"/>
                    <Button fx:id="btnOngletImage" onAction="#handleOngletImage"
                            style="-fx-background-color: #F0F8FC; -fx-text-fill: #023047;
                                   -fx-font-size: 12px; -fx-border-color: #8ECBE6; -fx-border-width: 1.5;
                                   -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;"
                            text="🖼️  Image"/>
                    <Button fx:id="btnOngletVideo" onAction="#handleOngletVideo"
                            style="-fx-background-color: #F0F8FC; -fx-text-fill: #023047;
                                   -fx-font-size: 12px; -fx-border-color: #8ECBE6; -fx-border-width: 1.5;
                                   -fx-padding: 8 18; -fx-background-radius: 20; -fx-cursor: hand;"
                            text="🎬  Vidéo"/>
                </HBox>
            </VBox>

            <!-- Zone fichiers -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox style="-fx-background-color: transparent;">
                    <padding><Insets bottom="28" left="32" right="32" top="24"/></padding>

                    <!-- Sous-titre de section -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding: 0 0 18 0;">
                        <Label fx:id="labelSectionTitre"
                               style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: #023047;"
                               text="📖  Cours disponibles"/>
                        <Label fx:id="labelSectionCount"
                               style="-fx-background-color: #229DBC; -fx-text-fill: white;
                                      -fx-font-size: 11px; -fx-font-weight: bold;
                                      -fx-padding: 3 10; -fx-background-radius: 12;"
                               text="3 fichiers"/>
                    </HBox>

                    <!-- Grille des fichiers -->
                    <GridPane fx:id="gridFichiers" hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints/>
                            <RowConstraints/>
                        </rowConstraints>

                        <!-- Fichier 1 — Cours (bleu) -->
                        <VBox spacing="0" GridPane.columnIndex="0" GridPane.rowIndex="0"
                              style="-fx-background-color: white; -fx-border-color: #8ECBE6;
                                     -fx-border-width: 1.5; -fx-border-radius: 14; -fx-background-radius: 14;
                                     -fx-effect: dropshadow(gaussian, rgba(2,48,71,0.09), 8, 0, 0, 2);">
                            <VBox style="-fx-background-color: #229DBC; -fx-background-radius: 12 12 0 0; -fx-padding: 12 16;">
                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" text="📖  Cours"/>
                            </VBox>
                            <VBox spacing="8" style="-fx-padding: 14 16 16 16;">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #023047;"
                                       text="Cours 1 — Introduction" wrapText="true"/>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #229DBC;"
                                       text="Algèbre linéaire et matrices — Chapitre 1" wrapText="true"/>
                                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 0 0 0;">
                                    <Label style="-fx-background-color: #F0F8FC; -fx-text-fill: #023047;
                                                  -fx-border-color: #8ECBE6; -fx-border-width: 1;
                                                  -fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-padding: 2 8; -fx-background-radius: 8; -fx-border-radius: 8;" text="PDF"/>
                                    <Label style="-fx-font-size: 10px; -fx-text-fill: #8ECBE6;" text="204 Ko"/>
                                </HBox>
                                <Button fx:id="btnDl1" maxWidth="Infinity" onAction="#handleTelecharger"
                                        style="-fx-background-color: #023047; -fx-text-fill: white;
                                               -fx-font-size: 12px; -fx-font-weight: bold;
                                               -fx-padding: 8 0; -fx-background-radius: 8; -fx-cursor: hand;"
                                        text="⬇  Télécharger"/>
                            </VBox>
                        </VBox>

                        <!-- Fichier 2 — Cours (jaune) -->
                        <VBox spacing="0" GridPane.columnIndex="1" GridPane.rowIndex="0"
                              style="-fx-background-color: white; -fx-border-color: #FEB707;
                                     -fx-border-width: 1.5; -fx-border-radius: 14; -fx-background-radius: 14;
                                     -fx-effect: dropshadow(gaussian, rgba(2,48,71,0.09), 8, 0, 0, 2);">
                            <VBox style="-fx-background-color: #FEB707; -fx-background-radius: 12 12 0 0; -fx-padding: 12 16;">
                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #023047;" text="📖  Cours"/>
                            </VBox>
                            <VBox spacing="8" style="-fx-padding: 14 16 16 16;">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #023047;"
                                       text="Cours 2 — Déterminants" wrapText="true"/>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #229DBC;"
                                       text="Algèbre linéaire et matrices — Chapitre 2" wrapText="true"/>
                                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 0 0 0;">
                                    <Label style="-fx-background-color: #FFF8E1; -fx-text-fill: #023047;
                                                  -fx-border-color: #FEB707; -fx-border-width: 1;
                                                  -fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-padding: 2 8; -fx-background-radius: 8; -fx-border-radius: 8;" text="PPTX"/>
                                    <Label style="-fx-font-size: 10px; -fx-text-fill: #8ECBE6;" text="358 Ko"/>
                                </HBox>
                                <Button fx:id="btnDl2" maxWidth="Infinity" onAction="#handleTelecharger"
                                        style="-fx-background-color: #023047; -fx-text-fill: white;
                                               -fx-font-size: 12px; -fx-font-weight: bold;
                                               -fx-padding: 8 0; -fx-background-radius: 8; -fx-cursor: hand;"
                                        text="⬇  Télécharger"/>
                            </VBox>
                        </VBox>

                        <!-- Fichier 3 — Cours (orange) -->
                        <VBox spacing="0" GridPane.columnIndex="2" GridPane.rowIndex="0"
                              style="-fx-background-color: white; -fx-border-color: #FB8402;
                                     -fx-border-width: 1.5; -fx-border-radius: 14; -fx-background-radius: 14;
                                     -fx-effect: dropshadow(gaussian, rgba(2,48,71,0.09), 8, 0, 0, 2);">
                            <VBox style="-fx-background-color: #FB8402; -fx-background-radius: 12 12 0 0; -fx-padding: 12 16;">
                                <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: white;" text="📖  Cours"/>
                            </VBox>
                            <VBox spacing="8" style="-fx-padding: 14 16 16 16;">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #023047;"
                                       text="Cours 3 — Systèmes linéaires" wrapText="true"/>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #229DBC;"
                                       text="Algèbre linéaire et matrices — Chapitre 3" wrapText="true"/>
                                <HBox alignment="CENTER_LEFT" spacing="8" style="-fx-padding: 4 0 0 0;">
                                    <Label style="-fx-background-color: #FFF3E0; -fx-text-fill: #023047;
                                                  -fx-border-color: #FB8402; -fx-border-width: 1;
                                                  -fx-font-size: 9px; -fx-font-weight: bold;
                                                  -fx-padding: 2 8; -fx-background-radius: 8; -fx-border-radius: 8;" text="DOCX"/>
                                    <Label style="-fx-font-size: 10px; -fx-text-fill: #8ECBE6;" text="307 Ko"/>
                                </HBox>
                                <Button fx:id="btnDl3" maxWidth="Infinity" onAction="#handleTelecharger"
                                        style="-fx-background-color: #023047; -fx-text-fill: white;
                                               -fx-font-size: 12px; -fx-font-weight: bold;
                                               -fx-padding: 8 0; -fx-background-radius: 8; -fx-cursor: hand;"
                                        text="⬇  Télécharger"/>
                            </VBox>
                        </VBox>

                        <!-- Message vide -->
                        <VBox fx:id="vboxVide" alignment="CENTER" spacing="10"
                              style="-fx-padding: 40 0 20 0; -fx-opacity: 0;"
                              GridPane.columnIndex="0" GridPane.columnSpan="3" GridPane.rowIndex="1">
                            <Label style="-fx-font-size: 40px;" text="📂"/>
                            <Label style="-fx-font-size: 14px; -fx-text-fill: #8ECBE6;"
                                   text="Aucun fichier disponible pour cette catégorie."/>
                        </VBox>

                    </GridPane>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
