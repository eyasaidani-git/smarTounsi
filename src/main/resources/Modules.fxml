<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModulesController"
            stylesheets="@/styles/upload.css"
            prefWidth="1280"
            prefHeight="750"
            styleClass="root-pane">

    <left>
        <VBox spacing="10" prefWidth="220" styleClass="sidebar">
            <padding>
                <Insets top="20" left="10" right="10" bottom="20"/>
            </padding>

            <Label text="SmarTounsi.com" styleClass="logo"/>
            <Separator/>

            <Label text="PRINCIPAL" styleClass="sidebar-section"/>
            <Button text="Dashboard" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleDashboard"/>
            <Button text="Modules" styleClass="menu-selected" maxWidth="Infinity" onMouseClicked="#handleModules"/>
            <Button text="Bibliotheque" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleDocuments"/>

            <Label text="OUTILS" styleClass="sidebar-section"/>
            <Button text="Upload" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleUpload"/>
            <Button text="Planning" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handlePlanning"/>
            <Button text="Favoris" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleFavoris"/>
            <Button text="Quiz" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleQuiz"/>
            <Button text="Projets" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleProjets"/>
            <Button text="Evenements" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleEvenements"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="AUTRE" styleClass="sidebar-section"/>
            <Button text="Profil" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleProfil"/>
            <Button text="Notifications" styleClass="menu-button" maxWidth="Infinity" onMouseClicked="#handleNotification"/>
            <Button text="Deconnexion" styleClass="menu-button danger-button" maxWidth="Infinity" onMouseClicked="#handleDeconnexion"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="page-shell">
            <HBox styleClass="topbar" alignment="CENTER_LEFT">
                <Label text="Modules" styleClass="topbar-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Etudiant" styleClass="student-pill"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox spacing="24" styleClass="main-content">
                    <padding>
                        <Insets top="28" right="34" bottom="28" left="34"/>
                    </padding>

                    <VBox spacing="10" styleClass="section-header">
                        <Label text="Modules" styleClass="page-title"/>
                        <Label text="Choisissez un module pour consulter ses documents pedagogiques."
                               styleClass="page-subtitle"/>

                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <TextField fx:id="tfRecherche"
                                       prefWidth="480"
                                       promptText="Rechercher un module..."
                                       styleClass="search-field"/>
                            <Button text="Rechercher"
                                    onAction="#handleRechercher"
                                    styleClass="search-button"/>
                        </HBox>
                    </VBox>

                    <GridPane hgap="20" vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                            <ColumnConstraints percentWidth="33.33"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="150"/>
                            <RowConstraints minHeight="150"/>
                        </rowConstraints>

                        <VBox alignment="CENTER" spacing="10" styleClass="module-card"
                              GridPane.columnIndex="0" GridPane.rowIndex="0"
                              onMouseClicked="#handleMathematiques">
                            <Label text="Mathematiques" styleClass="module-title"/>
                            <Label text="Algebre, analyse, statistiques" styleClass="module-subtitle"/>
                            <Button text="3 Documents" mouseTransparent="true" styleClass="count-pill"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10" styleClass="module-card"
                              GridPane.columnIndex="1" GridPane.rowIndex="0"
                              onMouseClicked="#handlePhysique">
                            <Label text="Physique" styleClass="module-title"/>
                            <Label text="Mecanique, electricite, optique" styleClass="module-subtitle"/>
                            <Button text="2 Documents" mouseTransparent="true" styleClass="count-pill"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10" styleClass="module-card"
                              GridPane.columnIndex="2" GridPane.rowIndex="0"
                              onMouseClicked="#handleReseaux">
                            <Label text="Reseaux" styleClass="module-title"/>
                            <Label text="TCP/IP, routage, protocoles" styleClass="module-subtitle"/>
                            <Button text="3 Documents" mouseTransparent="true" styleClass="count-pill count-pill-yellow"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10" styleClass="module-card"
                              GridPane.columnIndex="0" GridPane.rowIndex="1"
                              onMouseClicked="#handleUnix">
                            <Label text="UNIX" styleClass="module-title"/>
                            <Label text="Shell, Linux, administration" styleClass="module-subtitle"/>
                            <Button text="3 Documents" mouseTransparent="true" styleClass="count-pill"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10" styleClass="module-card"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"
                              onMouseClicked="#handleJava">
                            <Label text="JAVA" styleClass="module-title"/>
                            <Label text="POO, collections, Spring Boot" styleClass="module-subtitle"/>
                            <Button text="3 Documents" mouseTransparent="true" styleClass="count-pill"/>
                        </VBox>

                        <VBox alignment="CENTER" spacing="10" styleClass="module-card module-card-dark"
                              GridPane.columnIndex="2" GridPane.rowIndex="1"
                              onMouseClicked="#handleMachineLearning">
                            <Label text="Machine Learning" styleClass="module-title"/>
                            <Label text="Supervise, deep learning, IA" styleClass="module-subtitle"/>
                            <Button text="2 Documents" mouseTransparent="true" styleClass="count-pill count-pill-yellow"/>
                        </VBox>
                    </GridPane>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
