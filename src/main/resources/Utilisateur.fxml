<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="760.0" prefWidth="1180.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.UtilisateurController">
    <left>
        <VBox prefWidth="235.0" spacing="12.0" styleClass="sidebar">
            <Label styleClass="logo-title" text="SmarTounsi" />
            <Label styleClass="logo-subtitle" text="Espace admin • utilisateurs" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="🏠 Dashboard" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="📚 Modules" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="⬆ Upload" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="📅 Calendrier" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="🧪 Quiz" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="💼 Projets" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="🎉 Événements" />
            <Button maxWidth="Infinity" style="-fx-background-color: #023047; -fx-background-color: #8ECBE6;" styleClass="nav-button-active" text="👥 Utilisateurs" />
            <Button maxWidth="Infinity" onAction="#ouvrirMessages" styleClass="nav-button" text="💬 Messages privés" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="✅ Approbations" />
            <Button maxWidth="Infinity" styleClass="nav-button" text="Déconnexion" />
        </VBox>
    </left>
   <right>
        <VBox spacing="18.0" BorderPane.alignment="CENTER">
            <padding><Insets bottom="24" left="28" right="28" top="24" /></padding>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label styleClass="page-title" text="Gestion des utilisateurs" />
                    <Label styleClass="page-subtitle" text="Admin, professeur et étudiant — ajout, modification, activation et recherche." />
                </VBox>
                <TextField fx:id="searchField" prefWidth="280" promptText="Rechercher nom, prénom, email..." />
                <Button onAction="#rechercherUtilisateur" styleClass="secondary-button" text="Rechercher" />
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox prefWidth="370" spacing="12" styleClass="card">
                    <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #134E4A;" text="➕ Formulaire utilisateur" />
                    <TextField fx:id="nomField" promptText="Nom" />
                    <TextField fx:id="prenomField" promptText="Prénom" />
                    <TextField fx:id="emailField" promptText="Email" />
                    <PasswordField fx:id="passwordField" promptText="Mot de passe" />
                    <ComboBox fx:id="roleCombo" maxWidth="Infinity" promptText="Rôle" />
                    <TextField fx:id="photoField" promptText="URL / chemin photo profil (optionnel)" />
                    <CheckBox fx:id="actifCheck" selected="true" text="Compte actif" />
                    <HBox spacing="8">
                        <Button centerShape="false" maxWidth="Infinity" onAction="#ajouterUtilisateur" prefHeight="16.0" prefWidth="231.0" style="-fx-background-color: #023047;" styleClass="primary-button" text="Ajouter" HBox.hgrow="ALWAYS" />
                    </HBox>
                    <HBox spacing="8" />
                     <Button maxWidth="Infinity" onAction="#modifierUtilisateur" style="-fx-background-color: #023047;" styleClass="secondary-button" text="Modifier" textFill="#8ecbe6" />
                     <Button maxWidth="Infinity" onAction="#viderFormulaire" styleClass="secondary-button" text="Vider" />
                     <Button maxWidth="Infinity" onAction="#supprimerUtilisateur" styleClass="danger-button" text="Supprimer" />
                    <Label fx:id="statusLabel" styleClass="page-subtitle" text="Sélectionnez une ligne pour modifier un utilisateur." wrapText="true" />
                </VBox>

                <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #229DBC;" text="👥 Liste des utilisateurs" textFill="#229dbc" HBox.hgrow="ALWAYS" />
                        <Button onAction="#chargerUtilisateurs" prefHeight="33.0" prefWidth="94.0" styleClass="secondary-button" text="Actualiser" textAlignment="CENTER" translateX="465.0" />
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
   </right>
</BorderPane>
