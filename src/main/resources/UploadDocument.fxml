<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.UploadDocumentController"
            stylesheets="@/styles/upload.css"
            prefWidth="1280"
            prefHeight="750"
            styleClass="root-pane">

    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">
            <padding>
                <Insets top="20" left="10" right="10" bottom="20"/>
            </padding>

            <Label text="SmarTounsi.com" styleClass="logo"/>
            <Separator/>

            <Label text="PRINCIPAL" styleClass="sidebar-section"/>
            <Button text="Dashboard" styleClass="menu-button" maxWidth="Infinity" onAction="#handleDashboard"/>
            <Button text="Modules" styleClass="menu-button" maxWidth="Infinity" onAction="#handleModules"/>
            <Button text="Bibliotheque" styleClass="menu-button" maxWidth="Infinity" onAction="#handleDocuments"/>

            <Label text="OUTILS" styleClass="sidebar-section"/>
            <Button text="Upload" styleClass="menu-selected" maxWidth="Infinity" onAction="#handleUpload"/>
            <Button text="Planning" styleClass="menu-button" maxWidth="Infinity" onAction="#handlePlanning"/>
            <Button text="Favoris" styleClass="menu-button" maxWidth="Infinity" onAction="#handleFavoris"/>
            <Button text="Quiz" styleClass="menu-button" maxWidth="Infinity" onAction="#handleQuiz"/>
            <Button text="Projets" styleClass="menu-button" maxWidth="Infinity" onAction="#handleProjets"/>
            <Button text="Evenements" styleClass="menu-button" maxWidth="Infinity" onAction="#handleEvenements"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="AUTRE" styleClass="sidebar-section"/>
            <Button text="Profil" styleClass="menu-button" maxWidth="Infinity" onAction="#handleProfil"/>
            <Button text="Notifications" styleClass="menu-button" maxWidth="Infinity" onAction="#handleNotifications"/>
            <Button text="Deconnexion" styleClass="menu-button danger-button" maxWidth="Infinity" onAction="#handleDeconnexion"/>
        </VBox>
    </left>

    <center>
        <VBox spacing="0" styleClass="page-shell">
            <HBox styleClass="topbar" alignment="CENTER_LEFT">
                <Label text="Upload document" styleClass="topbar-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Etudiant" styleClass="student-pill"/>
            </HBox>

            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="scroll-pane">
                <VBox spacing="22" styleClass="main-content">
                    <padding>
                        <Insets top="28" right="34" bottom="28" left="34"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="4">
                            <Label text="Publier un document" styleClass="page-title"/>
                            <Label text="Ajoutez un fichier a un module. Il sera en attente d'approbation."
                                   styleClass="page-subtitle"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="18" maxWidth="780" styleClass="form-card">
                        <padding>
                            <Insets top="26" right="30" bottom="28" left="30"/>
                        </padding>

                        <VBox spacing="7">
                            <Label text="Module" styleClass="field-label"/>
                            <ComboBox fx:id="cbModule"
                                      maxWidth="Infinity"
                                      promptText="Choisir un module"
                                      styleClass="field-control"/>
                        </VBox>

                        <VBox spacing="7">
                            <Label text="Chapitre" styleClass="field-label"/>
                            <TextField fx:id="tfChapitre"
                                       promptText="Chapitre indisponible avec la table actuelle"
                                       styleClass="field-control"/>
                        </VBox>

                        <VBox spacing="7">
                            <Label text="Titre" styleClass="field-label"/>
                            <TextField fx:id="tfTitre"
                                       promptText="Titre du document"
                                       styleClass="field-control"/>
                        </VBox>

                        <VBox spacing="7">
                            <Label text="Description" styleClass="field-label"/>
                            <TextArea fx:id="tfDescription"
                                      prefRowCount="4"
                                      wrapText="true"
                                      promptText="Description courte"
                                      styleClass="field-control"/>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Type" styleClass="field-label"/>
                            <HBox spacing="10">
                                <ToggleButton fx:id="tbCours" text="Cours" onAction="#selectType" styleClass="type-toggle"/>
                                <ToggleButton fx:id="tbTD" text="TD" onAction="#selectType" styleClass="type-toggle"/>
                                <ToggleButton fx:id="tbExamenDS" text="Examen / DS" onAction="#selectType" styleClass="type-toggle"/>
                                <ToggleButton fx:id="tbLien" text="Lien utile" onAction="#selectType" styleClass="type-toggle"/>
                                <ToggleButton fx:id="tbImage" text="Image" onAction="#selectType" styleClass="type-toggle"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="8">
                            <Label text="Fichier" styleClass="field-label"/>
                            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="file-box">
                                <Button text="Choisir fichier"
                                        onAction="#choisirFichier"
                                        styleClass="secondary-button"/>
                                <VBox spacing="3">
                                    <Label fx:id="lblFichier" text="Aucun fichier choisi" styleClass="file-name"/>
                                    <Label fx:id="lblTailleFichier" text="" styleClass="file-size"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Button text="Publier"
                                    onAction="#ajouterDocument"
                                    styleClass="primary-button"/>
                            <Button text="Annuler"
                                    onAction="#annuler"
                                    styleClass="cancel-button"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
