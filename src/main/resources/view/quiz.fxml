<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.QuizController"
            stylesheets="@/style/quiz.css">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">
            <padding>
                <Insets top="20" left="10" right="10" bottom="20"/>
            </padding>

            <Label text="🧠 SmarTounsi.com" styleClass="logo"/>

            <Separator/>

            <Label text="PRINCIPAL" styleClass="sidebar-section"/>
            <Button text="🏠  Dashboard"    styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="📁  Modules"      styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="📚  Bibliothèque" styleClass="menu-button" maxWidth="Infinity"/>

            <Label text="OUTILS" styleClass="sidebar-section"/>
            <Button text="⬆  Upload"        styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="🗓  Calendrier"    styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="⭐  Favoris"      styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="🧩  Quiz"         styleClass="menu-selected" maxWidth="Infinity"/>
            <Button text="📋  Projets"      styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="🎉  Événements"   styleClass="menu-button" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="AUTRE" styleClass="sidebar-section"/>
            <Button text="👤  Profil"        styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="🔔  Notifications" styleClass="menu-button" maxWidth="Infinity"/>
            <Button text="🚪  Déconnexion"   styleClass="menu-button" maxWidth="Infinity"/>
        </VBox>
    </left>

    <!-- ===== CONTENU PRINCIPAL ===== -->
    <center>
        <VBox spacing="0">

            <!-- Topbar -->
            <HBox styleClass="topbar"
                  alignment="CENTER_LEFT"
                  spacing="0">
                <padding><Insets left="24" right="24"/></padding>
                <Label text="Quiz"
                       style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="👤 Étudiant"
                       style="-fx-background-color:rgba(255,255,255,0.12); -fx-text-fill:white;
                              -fx-font-size:12px; -fx-padding:6 14 6 14; -fx-background-radius:20;"/>
            </HBox>

            <!-- Contenu scrollable -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                <VBox spacing="24" styleClass="main-content">
                    <padding>
                        <Insets top="28" left="28" right="28" bottom="28"/>
                    </padding>

                    <!-- En-tête : titre + barre recherche + bouton créer -->
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <Label text="Quiz"
                               style="-fx-font-size:26px; -fx-font-weight:bold; -fx-text-fill:#FEB707;"/>
                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Barre de recherche -->
                        <TextField fx:id="searchField"
                                   promptText="🔍 Rechercher un quiz..."
                                   prefWidth="240"
                                   style="-fx-background-radius:8; -fx-border-color:#D5D8E0;
                                          -fx-border-radius:8; -fx-padding:8 12 8 12;"/>

                        <!-- Filtre matière -->
                        <ComboBox fx:id="comboMatiere"
                                  prefWidth="180"
                                  style="-fx-background-radius:8; -fx-border-color:#D5D8E0;
                                         -fx-border-radius:8;"/>

                        <!-- Bouton rechercher -->
                        <Button text="Rechercher"
                                styleClass="search-button"
                                onAction="#rechercherQuiz"/>

                        <!-- Bouton créer -->
                        <Button text="+ Créer un quiz"
                                styleClass="yellow-button"
                                onAction="#creerQuiz"/>
                    </HBox>

                    <!-- Grille des quiz (remplie dynamiquement par le controller) -->
                    <GridPane fx:id="quizGrid"
                              hgap="20"
                              vgap="20">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50"/>
                            <ColumnConstraints percentWidth="50"/>
                        </columnConstraints>
                    </GridPane>

                    <!-- Message état vide -->
                    <VBox fx:id="emptyLabel"
                          alignment="CENTER"
                          spacing="12"
                          visible="false"
                          managed="false"
                          style="-fx-padding:60 0 60 0;">
                        <Label text="📝"
                               style="-fx-font-size:48px;"/>
                        <Label text="Aucun quiz disponible"
                               style="-fx-font-size:18px; -fx-font-weight:bold; -fx-text-fill:#555870;"/>
                        <Label text="Cliquez sur '+ Créer un quiz' pour en ajouter un."
                               style="-fx-font-size:13px; -fx-text-fill:#888;"/>
                    </VBox>

                </VBox>
            </ScrollPane>
        </VBox>
    </center>
</BorderPane>
