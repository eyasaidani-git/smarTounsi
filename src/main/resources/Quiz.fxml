<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<HBox prefHeight="780.0"
      prefWidth="1280.0"
      styleClass="app-root"
      stylesheets="@quiz.css"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="Controllers.QuizController">

    <VBox prefWidth="175.0" styleClass="sidebar">
        <padding>
            <Insets top="16.0" right="0.0" bottom="16.0" left="0.0"/>
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="brand-box">
            <padding>
                <Insets top="0.0" right="14.0" bottom="20.0" left="14.0"/>
            </padding>
            <Label text="🧠" styleClass="brand-icon"/>
            <Label text="SmarTounsi.com" styleClass="brand-text"/>
        </HBox>

        <VBox spacing="6.0" styleClass="nav-section">
            <Label text="PRINCIPAL" styleClass="nav-title"/>
            <Button text="🏠  Dashboard" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📁  Modules" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="📚  Bibliothèque" styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6.0" styleClass="nav-section">
            <Label text="OUTILS" styleClass="nav-title"/>
            <Button text="⬆  Upload" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="🗓  Calendrier" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="⭐  Favoris" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="🧩  Quiz" styleClass="nav-button-active" maxWidth="Infinity"/>
            <Button text="🗂  Projets" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="🎉  Événements" styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="6.0" styleClass="nav-section">
            <Label text="AUTRE" styleClass="nav-title"/>
            <Button text="👤  Profil" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="🔔  Notifications" styleClass="nav-button" maxWidth="Infinity"/>
            <Button text="🚪  Déconnexion" styleClass="nav-button" maxWidth="Infinity"/>
        </VBox>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" styleClass="page-wrapper">

        <HBox alignment="CENTER_RIGHT" prefHeight="72.0" spacing="12.0" styleClass="topbar">
            <padding>
                <Insets top="14.0" right="22.0" bottom="14.0" left="22.0"/>
            </padding>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="🎓" styleClass="student-icon"/>
            <Label text="Étudiant" styleClass="student-label"/>
        </HBox>

        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    VBox.vgrow="ALWAYS"
                    styleClass="content-scroll">
            <content>
                <VBox spacing="24.0" styleClass="content-body">
                    <padding>
                        <Insets top="34.0" right="38.0" bottom="40.0" left="38.0"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="16.0">
                        <VBox spacing="4.0">
                            <Label text="Quiz" styleClass="page-title"/>
                            <Label text="Choisissez un quiz par matière ou créez votre propre quiz."
                                   styleClass="page-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Button text="+ Créer un quiz"
                                onAction="#openCreateQuizDialog"
                                styleClass="create-button"/>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="filter-bar">
                        <Label text="Matière :" styleClass="filter-label"/>

                        <ComboBox fx:id="filterMatiereComboBox"
                                  prefWidth="220.0"
                                  onAction="#filterQuizzes"
                                  styleClass="filter-combo"/>

                        <Label text="Recherche :" styleClass="filter-label"/>

                        <TextField fx:id="searchField"
                                   promptText="chercher un quiz..."
                                   onKeyReleased="#handleSearch"
                                   prefWidth="260.0"
                                   styleClass="search-field"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="totalQuizLabel"
                               text="0 quiz"
                               styleClass="total-label"/>
                    </HBox>

                    <GridPane fx:id="quizGrid"
                              hgap="18.0"
                              vgap="18.0"
                              styleClass="quiz-grid">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0"/>
                            <ColumnConstraints percentWidth="50.0"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>
            </content>
        </ScrollPane>
    </VBox>
</HBox>