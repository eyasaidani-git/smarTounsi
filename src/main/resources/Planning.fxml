<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.PlanningController"
            stylesheets="@styles/planning.css"
            prefWidth="1280"
            prefHeight="750">

    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="10">
            <padding>
                <Insets top="20" left="10" right="10" bottom="20"/>
            </padding>

            <Label text="SmarTounsi.com" styleClass="logo-text"/>

            <Region prefHeight="16"/>

            <Label text="PRINCIPAL" styleClass="section-label"/>
            <Button text="Dashboard" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleDashboard"/>
            <Button text="Modules" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleModules"/>
            <Button text="Bibliotheque" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleDocuments"/>

            <Region prefHeight="10"/>

            <Label text="OUTILS" styleClass="section-label"/>
            <Button text="Upload" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleUpload"/>
            <Button text="Planning" styleClass="nav-btn nav-active" maxWidth="Infinity" onAction="#handlePlanning"/>
            <Button text="Favoris" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleFavoris"/>
            <Button text="Quiz" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleQuiz"/>
            <Button text="Projets" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleProjets"/>
            <Button text="Evenements" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleEvenements"/>

            <Region prefHeight="10"/>

            <Label text="AUTRE" styleClass="section-label"/>
            <Button text="Profil" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleProfil"/>
            <Button text="Notifications" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleNotifications"/>
            <Button text="Deconnexion" styleClass="nav-btn nav-danger" maxWidth="Infinity" onAction="#handleDeconnexion"/>
        </VBox>
    </left>

    <center>
        <HBox spacing="16">
            <padding>
                <Insets top="24" left="24" right="24" bottom="24"/>
            </padding>

            <VBox spacing="14" HBox.hgrow="ALWAYS">
                <Label text="Planning" styleClass="page-title"/>

                <VBox styleClass="card" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="20" left="20" right="20" bottom="20"/>
                    </padding>

                    <HBox alignment="CENTER" spacing="16" styleClass="month-nav">
                        <Button fx:id="btnPrevMonth" text="&lt;" styleClass="nav-arrow" onAction="#prevMonth"/>
                        <Label fx:id="lblMonthYear" text="Mai 2026" styleClass="month-label"/>
                        <Button fx:id="btnNextMonth" text="&gt;" styleClass="nav-arrow" onAction="#nextMonth"/>
                    </HBox>

                    <Region prefHeight="12"/>

                    <GridPane fx:id="calendarGrid"
                              hgap="6"
                              vgap="6"
                              styleClass="calendar-grid"
                              VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="14.28"/>
                        </columnConstraints>
                    </GridPane>
                </VBox>
            </VBox>

            <VBox fx:id="todoPanel"
                  styleClass="card todo-panel"
                  prefWidth="315"
                  minWidth="315"
                  spacing="14">
                <padding>
                    <Insets top="20" left="18" right="18" bottom="20"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="To Do" styleClass="todo-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSelectedDate" text="13 Mai 2026" styleClass="badge-date"/>
                </HBox>

                <Separator styleClass="todo-sep"/>

                <VBox spacing="5">
                    <Label text="Titre / Document" styleClass="field-label"/>
                    <TextField fx:id="fieldTitre"
                               promptText="ex: Revision Reseaux"
                               styleClass="field-input"/>
                </VBox>

                <HBox spacing="10">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Type :" styleClass="field-label"/>
                        <ComboBox fx:id="comboType" styleClass="field-combo" maxWidth="Infinity"/>
                    </VBox>
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label text="Heure :" styleClass="field-label"/>
                        <TextField fx:id="fieldHeure"
                                   promptText="09:00 AM"
                                   styleClass="field-input"/>
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Description" styleClass="field-label"/>
                    <TextArea fx:id="fieldDescription"
                              promptText="Ajouter une description..."
                              styleClass="field-textarea"
                              wrapText="true"
                              prefHeight="75"/>
                </VBox>

                <VBox spacing="5">
                    <Label text="Pieces jointes" styleClass="field-label"/>

                    <VBox fx:id="dropZone"
                          styleClass="drop-zone"
                          alignment="CENTER"
                          spacing="5"
                          prefHeight="95"
                          onDragOver="#handleDragOver"
                          onDragDropped="#handleDragDropped">
                        <Label text="Glissez vos fichiers ici" styleClass="drop-hint"/>
                        <Label text="PDF - DOCX - PPTX - MP4 - PNG - URL" styleClass="drop-sub"/>
                        <Button fx:id="btnParcourir"
                                text="Parcourir..."
                                styleClass="btn-parcourir"
                                onAction="#parcourirFichier"/>
                    </VBox>

                    <ListView fx:id="listFichiers" styleClass="files-list" prefHeight="72"/>
                </VBox>

                <Button fx:id="btnAjouter"
                        text="+ Ajouter a ce jour"
                        styleClass="btn-add"
                        maxWidth="Infinity"
                        onAction="#ajouterTodo"/>

                <Separator styleClass="todo-sep"/>

                <VBox spacing="6" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="Prevu ce jour -" styleClass="preview-label"/>
                        <Label fx:id="lblCount" text="0 elements" styleClass="preview-count"/>
                    </HBox>

                    <ScrollPane styleClass="scroll-todos"
                                fitToWidth="true"
                                prefHeight="130"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="vboxTodos" spacing="6" styleClass="todos-container">
                            <padding>
                                <Insets top="4" left="2" right="2" bottom="4"/>
                            </padding>
                        </VBox>
                    </ScrollPane>
                </VBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
