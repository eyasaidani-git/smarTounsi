<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ProjetController"
            stylesheets="@styles/stylesprojet.css"
            prefWidth="1200"
            prefHeight="750"
            styleClass="root-pane">

    <top>
        <HBox styleClass="top-bar" alignment="CENTER_LEFT">
            <Label text="SmarTounsi.com" styleClass="logo-text"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label text="Etudiant" styleClass="student-text"/>
        </HBox>
    </top>

    <left>
        <VBox spacing="10"
              prefWidth="220"
              styleClass="sidebar">
            <padding>
                <Insets top="20" left="10" right="10" bottom="20"/>
            </padding>

            <Label text="SmarTounsi.com" styleClass="logo"/>
            <Separator/>

            <Label text="PRINCIPAL" styleClass="sidebar-section"/>
            <Button text="Dashboard" styleClass="menu-button" maxWidth="Infinity" onAction="#handleDashboard"/>
            <Button text="Modules" styleClass="menu-button" maxWidth="Infinity" onAction="#handleModules"/>
            <Button text="Bibliotheque" styleClass="menu-button" maxWidth="Infinity" onAction="#handleDocuments"/>

            <Label text="OUTILS" styleClass="sidebar-section"/>
            <Button text="Upload" styleClass="menu-button" maxWidth="Infinity" onAction="#handleUpload"/>
            <Button text="Planning" styleClass="menu-button" maxWidth="Infinity" onAction="#handlePlanning"/>
            <Button text="Favoris" styleClass="menu-button" maxWidth="Infinity" onAction="#handleFavoris"/>
            <Button text="Quiz" styleClass="menu-button" maxWidth="Infinity" onAction="#handleQuiz"/>
            <Button text="Projets" styleClass="menu-selected" maxWidth="Infinity" onAction="#handleProjets"/>
            <Button text="Evenements" styleClass="menu-button" maxWidth="Infinity" onAction="#handleEvenements"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="AUTRE" styleClass="sidebar-section"/>
            <Button text="Profil" styleClass="menu-button" maxWidth="Infinity" onAction="#handleProfil"/>
            <Button text="Notifications" styleClass="menu-button" maxWidth="Infinity" onAction="#handleNotifications"/>
            <Button text="Deconnexion" styleClass="menu-button" maxWidth="Infinity" onAction="#handleDeconnexion"/>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content" spacing="20">
            <HBox alignment="CENTER_LEFT">
                <Label text="Projets" styleClass="page-title"/>
                <Pane HBox.hgrow="ALWAYS"/>
                <Button text="+ Nouveau projet"
                        onAction="#showAddForm"
                        styleClass="new-button"/>
            </HBox>

            <VBox fx:id="listPane" spacing="20">
                <HBox spacing="10">
                    <TextField fx:id="searchField"
                               promptText="Rechercher un projet..."
                               styleClass="search-field"
                               HBox.hgrow="ALWAYS"/>

                    <Button text="Rechercher"
                            styleClass="search-button"/>
                </HBox>

                <ScrollPane fitToWidth="true" styleClass="scroll-pane">
                    <FlowPane fx:id="cardsContainer"
                              hgap="18"
                              vgap="18"
                              prefWrapLength="950"/>
                </ScrollPane>
            </VBox>

            <VBox fx:id="addFormPane"
                  spacing="16"
                  visible="false"
                  managed="false"
                  styleClass="form-card">

                <Label text="Ajouter un projet" styleClass="form-title"/>

                <VBox spacing="7">
                    <Label text="Nom du projet" styleClass="form-label"/>
                    <TextField fx:id="nomField"
                               promptText="ex : Application de gestion"
                               styleClass="form-field"/>
                </VBox>

                <VBox spacing="7">
                    <Label text="Description" styleClass="form-label"/>
                    <TextArea fx:id="descriptionArea"
                              promptText="Decrire brievement le projet..."
                              prefRowCount="4"
                              wrapText="true"
                              styleClass="form-area"/>
                </VBox>

                <VBox spacing="7">
                    <Label text="Collaborateurs separes par virgule" styleClass="form-label"/>
                    <TextField fx:id="collaborateursField"
                               promptText="ex : Ahmed, Sara, Karim"
                               styleClass="form-field"/>
                </VBox>

                <VBox spacing="8">
                    <Label text="Le projet contient :" styleClass="form-label"/>

                    <HBox spacing="18">
                        <CheckBox fx:id="codeCheckBox"
                                  text="Code"
                                  selected="true"/>

                        <CheckBox fx:id="presentationCheckBox"
                                  text="Presentation"
                                  selected="true"/>

                        <CheckBox fx:id="rapportCheckBox"
                                  text="Rapport"
                                  selected="true"/>
                    </HBox>
                </VBox>

                <HBox spacing="12">
                    <Button text="Ajouter le projet"
                            onAction="#createProject"
                            styleClass="submit-button"/>

                    <Button text="Annuler"
                            onAction="#hideAddForm"
                            styleClass="cancel-button"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
