<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ParticipationEvenementController"
            stylesheets="@styles/profil.css"
            styleClass="app-root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" styleClass="topbar">
            <children>
                <Button text="← Retour événements"
                        onAction="#retour"
                        styleClass="save-button"/>

                <Label fx:id="titleLabel"
                       text="Participants / Intéressés"
                       styleClass="top-logo-text"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Label text="🎟 Participations" styleClass="role-header"/>
            </children>
        </HBox>
    </top>

    <left>
        <VBox styleClass="sidebar" spacing="8.0">
            <children>
                <Label text="PRINCIPAL" styleClass="sidebar-title"/>

                <Button text="🏠  Dashboard"
                        onAction="#goDashboard"
                        styleClass="sidebar-button"/>

                <Button text="📁  Modules"
                        onAction="#goModules"
                        styleClass="sidebar-button"/>

                <Button text="📚  Bibliothèque"
                        onAction="#goBibliotheque"
                        styleClass="sidebar-button"/>

                <Label text="OUTILS" styleClass="sidebar-title"/>

                <Button text="⬆️  Upload"
                        onAction="#goUpload"
                        styleClass="sidebar-button"/>

                <Button text="🗓️  Calendrier"
                        onAction="#goCalendrier"
                        styleClass="sidebar-button"/>

                <Button text="⭐  Favoris"
                        onAction="#goFavoris"
                        styleClass="sidebar-button"/>

                <Button text="🧩  Quiz"
                        onAction="#goQuiz"
                        styleClass="sidebar-button"/>

                <Button text="💼  Projets"
                        onAction="#goProjets"
                        styleClass="sidebar-button"/>

                <Button text="🎉  Événements"
                        onAction="#goEvenements"
                        styleClass="sidebar-button-active"/>

                <Label text="AUTRE" styleClass="sidebar-title"/>

                <Button text="👤  Profil"
                        onAction="#goProfil"
                        styleClass="sidebar-button"/>

                <Button text="🔔  Notifications"
                        onAction="#goNotifications"
                        styleClass="sidebar-button"/>

                <Button text="🚪  Déconnexion"
                        onAction="#deconnexion"
                        styleClass="sidebar-button"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="18" styleClass="content">
            <children>

                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <children>
                        <Button text="Rafraîchir"
                                onAction="#charger"
                                styleClass="edit-button"/>

                        <Button text="Confirmer paiement"
                                onAction="#confirmerPaiement"
                                styleClass="save-button"/>

                        <Button text="Présent"
                                onAction="#marquerPresent"
                                styleClass="edit-button"/>

                        <Button text="Absent"
                                onAction="#marquerAbsent"
                                styleClass="sidebar-button"/>

                        <Button text="Annuler"
                                onAction="#annuler"
                                styleClass="sidebar-button"/>

                        <Button text="Supprimer"
                                onAction="#supprimer"
                                style="-fx-background-color: #ef4444; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;"/>
                    </children>
                </HBox>

                <TableView fx:id="participationTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn"
                                     text="ID"
                                     prefWidth="60"/>

                        <TableColumn fx:id="utilisateurColumn"
                                     text="Utilisateur"
                                     prefWidth="190"/>

                        <TableColumn fx:id="evenementColumn"
                                     text="Événement"
                                     prefWidth="220"/>

                        <TableColumn fx:id="typeColumn"
                                     text="Type"
                                     prefWidth="130"/>

                        <TableColumn fx:id="statutColumn"
                                     text="Statut"
                                     prefWidth="160"/>

                        <TableColumn fx:id="montantColumn"
                                     text="Montant"
                                     prefWidth="100"/>

                        <TableColumn fx:id="dateColumn"
                                     text="Date participation"
                                     prefWidth="200"/>
                    </columns>
                </TableView>

            </children>
        </VBox>
    </center>
</BorderPane>